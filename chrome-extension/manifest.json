{
	"name": "動画プレイヤー補助",
	"version": "0.1.0",
	"manifest_version": 3,

	"description": "<video>動画を再生した時にコントローラーを補助する",

	"permissions": [
		"scripting",
		"contextMenus",
		"activeTab"
	],

	"background": {
		"service_worker": "background.js"
	},

	"content_scripts": [{
		"matches": [
			"http://*/*.mp4",
			"file:///*.mp4"
		],
		"js": [
			"VideoPlayerController.js"
		]
	}]
}
